# ─────────────────────────────────────────────────────────────────
# NearMart — Root .env.example
# Copy this to .env and fill in real values before running.
# DO NOT commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── MongoDB ──────────────────────────────────────────────────────
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=nearmart_secret
MONGO_APP_USER=nearmart_app
MONGO_APP_PASSWORD=nearmart_app_secret
MONGO_HOST=localhost
MONGO_PORT=27017

# Per-service connection strings (used by each microservice)
AUTH_SERVICE_MONGO_URI=mongodb://nearmart_app:nearmart_app_secret@localhost:27017/nearmart_auth?authSource=admin
VENDOR_SERVICE_MONGO_URI=mongodb://nearmart_app:nearmart_app_secret@localhost:27017/nearmart_vendors?authSource=admin
CATALOG_SERVICE_MONGO_URI=mongodb://nearmart_app:nearmart_app_secret@localhost:27017/nearmart_catalog?authSource=admin
ORDER_SERVICE_MONGO_URI=mongodb://nearmart_app:nearmart_app_secret@localhost:27017/nearmart_orders?authSource=admin
PAYMENT_SERVICE_MONGO_URI=mongodb://nearmart_app:nearmart_app_secret@localhost:27017/nearmart_payments?authSource=admin
REVIEW_SERVICE_MONGO_URI=mongodb://nearmart_app:nearmart_app_secret@localhost:27017/nearmart_reviews?authSource=admin
REALTIME_SERVICE_MONGO_URI=mongodb://nearmart_app:nearmart_app_secret@localhost:27017/nearmart_realtime?authSource=admin
NOTIFICATION_SERVICE_MONGO_URI=mongodb://nearmart_app:nearmart_app_secret@localhost:27017/nearmart_notifications?authSource=admin

# ── Redis ─────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=nearmart_redis
REDIS_URL=redis://:nearmart_redis@localhost:6379

# ── RabbitMQ ─────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=nearmart
RABBITMQ_PASSWORD=nearmart_rabbit
RABBITMQ_VHOST=nearmart
RABBITMQ_URL=amqp://nearmart:nearmart_rabbit@localhost:5672/nearmart

# ── JWT / Auth ────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=another_long_random_secret_for_refresh_tokens
REFRESH_TOKEN_EXPIRES_IN=7d   # days → stored as TTL in MongoDB

# ── Auth Service ──────────────────────────────────────────────────
AUTH_SERVICE_PORT=4001
MONGO_URI=mongodb://nearmart_app:nearmart_app_secret@localhost:27017/nearmart_auth?authSource=admin

# ── Vendor Service ────────────────────────────────────────────────
VENDOR_SERVICE_PORT=4002

# ── Catalog Service ───────────────────────────────────────────────
CATALOG_SERVICE_PORT=4003

# ── Order Service ─────────────────────────────────────────────────
ORDER_SERVICE_PORT=4004

# ── Payment Service ───────────────────────────────────────────────
PAYMENT_SERVICE_PORT=4005
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── Review Service ────────────────────────────────────────────────
REVIEW_SERVICE_PORT=4006

# ── Realtime Service ──────────────────────────────────────────────
REALTIME_SERVICE_PORT=4007

# ── Notification Service ──────────────────────────────────────────
NOTIFICATION_SERVICE_PORT=4008

# ── API Gateway ───────────────────────────────────────────────────
GATEWAY_PORT=3000

# ── General ───────────────────────────────────────────────────────
NODE_ENV=development
