{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "vendor.approved",
  "description": "Published when an admin approves a vendor registration.",
  "type": "object",
  "required": ["eventId", "eventType", "timestamp", "payload"],
  "properties": {
    "eventId":   { "type": "string", "format": "uuid" },
    "eventType": { "type": "string", "const": "vendor.approved" },
    "timestamp": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "required": ["vendorId", "userId"],
      "properties": {
        "vendorId": { "type": "string" },
        "userId":   { "type": "string" }
      }
    }
  },
  "example": {
    "eventId":   "b8c9d0e1-f2a3-4567-bcde-678901234567",
    "eventType": "vendor.approved",
    "timestamp": "2024-01-15T09:00:00.000Z",
    "payload": {
      "vendorId": "ven_xyz456",
      "userId":   "usr_owner_789"
    }
  }
}
