{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "review.created",
  "description": "Published when a buyer submits a review for a vendor/order.",
  "type": "object",
  "required": ["eventId", "eventType", "timestamp", "payload"],
  "properties": {
    "eventId":   { "type": "string", "format": "uuid" },
    "eventType": { "type": "string", "const": "review.created" },
    "timestamp": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "required": ["vendorId", "rating"],
      "properties": {
        "vendorId": { "type": "string" },
        "rating":   { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    }
  },
  "example": {
    "eventId":   "a7b8c9d0-e1f2-3456-abcd-567890123456",
    "eventType": "review.created",
    "timestamp": "2024-01-15T14:00:00.000Z",
    "payload": {
      "vendorId": "ven_xyz456",
      "rating":   5
    }
  }
}
