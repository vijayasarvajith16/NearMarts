{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "payment.captured",
  "description": "Published when a payment is successfully captured for an order.",
  "type": "object",
  "required": ["eventId", "eventType", "timestamp", "payload"],
  "properties": {
    "eventId":   { "type": "string", "format": "uuid" },
    "eventType": { "type": "string", "const": "payment.captured" },
    "timestamp": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "required": ["orderId", "paymentId", "amount"],
      "properties": {
        "orderId":   { "type": "string" },
        "paymentId": { "type": "string" },
        "amount":    { "type": "number", "minimum": 0 }
      }
    }
  },
  "example": {
    "eventId":   "b2c3d4e5-f6a7-8901-bcde-f12345678901",
    "eventType": "payment.captured",
    "timestamp": "2024-01-15T10:35:00.000Z",
    "payload": {
      "orderId":   "ord_abc123",
      "paymentId": "pay_razorpay_001",
      "amount":    499.00
    }
  }
}
