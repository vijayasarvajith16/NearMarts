{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "order.delivered",
  "description": "Published when an order is marked as delivered to the buyer.",
  "type": "object",
  "required": ["eventId", "eventType", "timestamp", "payload"],
  "properties": {
    "eventId":   { "type": "string", "format": "uuid" },
    "eventType": { "type": "string", "const": "order.delivered" },
    "timestamp": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "required": ["orderId", "buyerId", "vendorId"],
      "properties": {
        "orderId":  { "type": "string" },
        "buyerId":  { "type": "string" },
        "vendorId": { "type": "string" }
      }
    }
  },
  "example": {
    "eventId":   "f6a7b8c9-d0e1-2345-fabc-456789012345",
    "eventType": "order.delivered",
    "timestamp": "2024-01-15T13:20:00.000Z",
    "payload": {
      "orderId":  "ord_abc123",
      "buyerId":  "usr_buyer_001",
      "vendorId": "ven_xyz456"
    }
  }
}
