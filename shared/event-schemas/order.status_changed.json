{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "order.status_changed",
  "description": "Published whenever an order transitions between statuses.",
  "type": "object",
  "required": ["eventId", "eventType", "timestamp", "payload"],
  "properties": {
    "eventId":   { "type": "string", "format": "uuid" },
    "eventType": { "type": "string", "const": "order.status_changed" },
    "timestamp": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "required": ["orderId", "oldStatus", "newStatus"],
      "properties": {
        "orderId":   { "type": "string" },
        "oldStatus": {
          "type": "string",
          "enum": ["pending", "confirmed", "preparing", "out_for_delivery", "delivered", "cancelled"]
        },
        "newStatus": {
          "type": "string",
          "enum": ["pending", "confirmed", "preparing", "out_for_delivery", "delivered", "cancelled"]
        }
      }
    }
  },
  "example": {
    "eventId":   "e5f6a7b8-c9d0-1234-efab-345678901234",
    "eventType": "order.status_changed",
    "timestamp": "2024-01-15T11:00:00.000Z",
    "payload": {
      "orderId":   "ord_abc123",
      "oldStatus": "confirmed",
      "newStatus": "preparing"
    }
  }
}
